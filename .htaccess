# Newspapers South Africa — Apache configuration (cPanel / shared hosting)

# ----------------------------------------------------------------------
# Front controller: route everything through index.php
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # If you deploy into a subdirectory, set RewriteBase accordingly.
    # RewriteBase /

    # Serve existing files and directories directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# ----------------------------------------------------------------------
# Protect sensitive files
# ----------------------------------------------------------------------
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>

# Block access to dot-files/dirs (e.g. .git).
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known) - [F]
</IfModule>

# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# ----------------------------------------------------------------------
# Default document
# ----------------------------------------------------------------------
DirectoryIndex index.php

# ----------------------------------------------------------------------
# Compression & caching for static assets
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
